# U-Boot defconfig sketch for an mt32-t113 board: Allwinner T113-i with
# EXTERNAL DDR3.  Drop into u-boot/configs/ and build with
#   make CROSS_COMPILE=arm-linux-gnueabihf- t113i_mt32_defconfig
#   make CROSS_COMPILE=arm-linux-gnueabihf- -j$(nproc)
# Output: u-boot-sunxi-with-spl.bin
#
# UNVERIFIED ON HARDWARE.  Provenance for every non-obvious line is below.
# Generate the DRAM block yourself with:
#   scripts/ddrpara.py kconfig --preset mt32-t113
#
# Baseline: u-boot configs/mangopi_mq_r_defconfig (the mainline T113-S3 board,
# added in v2024.01), with the DRAM block swapped for the external-DDR3 values
# read out of SyterKit's 100ask T113-i board.dts.  See ../BRINGUP.md section 2.

CONFIG_ARM=y
CONFIG_ARCH_SUNXI=y

# T113-i, T113-S3, T113-S4, R528, D1 and D1s are all the same die family in
# mainline; there is no separate T113 symbol.  MACH_SUN8I_R528 selects
# SUNXI_GEN_NCAT2, SUNXI_NEW_PINCTRL and DRAM_SUN20I_D1.
CONFIG_MACH_SUN8I_R528=y

# Our own devicetree. Start by copying
#   arch/arm/dts/sun8i-t113s-mangopi-mq-r-t113.dts
# or the Tronlong one from nickfox-taterli/t113-uboot
#   arch/arm/dts/sun8i-t113i-minievm.dts
# and fixing the console UART pinmux, MMC0 pins and regulators for our board.
CONFIG_DEFAULT_DEVICE_TREE="allwinner/sun8i-t113i-mt32"

CONFIG_SPL=y

# --- DRAM: EXTERNAL DDR3, 512 MB (one x16 4 Gbit part) -----------------------
# The driver auto-detects rank count, DQ width, row/bank/page size, so the
# DENSITY IS NOT CONFIGURED HERE - 256 MB or 1 GB would use the same lines.
# What is configured is electrical trim, and it is board specific.
CONFIG_DRAM_CLK=792
CONFIG_SUNXI_DRAM_TYPE_DDR3=y
CONFIG_DRAM_ZQ=8092667

# TPR0 IS NOT OPTIONAL, EVEN THOUGH THE DRIVER IGNORES IT.
# Corrected 2026-09-18 by building it.  drivers/ram/sunxi/Kconfig declares all
# five DRAM_SUNXI_* symbols as `hex` with NO `default` line (lines 10-34), so a
# defconfig that omits one makes `make syncconfig` stop and prompt:
#     DRAM TPR0 parameter (DRAM_SUNXI_TPR0) [] (NEW)
#     Error in reading or end of file.
# and the build never completes.  Earlier revisions of this file left TPR0 out
# on the grounds that dram_sun20i_d1.c never reads it -- true, and irrelevant.
# The value below is the driver's own hardcoded .dram_tpr0
# (dram_sun20i_d1.c:1379), so it is a no-op with the right shape.
CONFIG_DRAM_SUNXI_TPR0=0x004a2195

# ODT_EN=1: the 100ask T113-i external-DDR3 board enables on-die termination.
# The co-packaged T113-S3 uses 0.  The Tronlong T113-i MiniEVM also uses 0 on
# external DDR3, so this is a board call, not a part call.  Try 1 first.
CONFIG_DRAM_SUNXI_ODT_EN=0x1

# TPR11/TPR12: per-byte-lane read and write delay trim, applied in
# eye_delay_compensation().  This is the PCB trace-delay knob.  These two lines
# are what you sweep if DRAM is flaky on our own layout.
CONFIG_DRAM_SUNXI_TPR11=0x770000
CONFIG_DRAM_SUNXI_TPR12=0x2

# TPR13 feature bits.  0x34050100 vs the T113-S3's 0x34000100 adds:
#   bit 16 - internal ZQ only
#   bit 18 - force AC remapping table 7 instead of the efuse-selected table
# Bit 18 matters most: on the co-packaged parts an efuse at SID+0x28[11:8]
# selects the address/command pin swizzle that matches the internal bond wires.
# On a part with external DDR3 that efuse means nothing useful, so the
# external-DDR3 board forces a known table.  OUR PCB MUST BE ROUTED TO MATCH
# WHICHEVER TABLE WE SET HERE - see ../BRINGUP.md section 2, "AC remapping".
CONFIG_DRAM_SUNXI_TPR13=0x34050100

# Minimum DRAM the SPL will accept before declaring failure.
CONFIG_SUNXI_MINIMUM_DRAM_MB=128

# --- Console ----------------------------------------------------------------
# CONS_INDEX is 1-based: 1=UART0 ... 4=UART3.
#
# CORRECTED 2026-09-18 by reading the code that this symbol actually drives.
# The SPL does NOT take its console pinmux from the devicetree.  It is a C
# #if ladder in arch/arm/mach-sunxi/board.c, and for MACH_SUN8I_R528 it has
# exactly TWO arms:
#
#   CONS_INDEX == 1  ->  PE2, PE3   mux 6  (UART0)   board.c:160-163
#   CONS_INDEX == 4  ->  PB6, PB7   mux 7  (UART3)   board.c:181-184
#
# anything else hits `#error Unsupported console port number` (board.c:195).
# So a board that puts UART0 on PB8/PB9 -- which is what the 100ask T113-i
# devkit does, and which the pinctrl driver's function table does allow
# (drivers/pinctrl/sunxi/pinctrl-sunxi.c:612, "uart0" = mux 6 on PB0-PB1,
# PB8-PB9, PE2-PE3) -- gets a SILENT SPL and a working U-Boot proper, because
# only U-Boot proper reads the DT.  That is a nasty first-boot failure mode.
#
# This board therefore puts the console on UART0 PE2/PE3, the only UART0 pin
# pair mainline muxes without a patch.  ../dts/sun8i-t113i-mt32.dts agrees.
# This is a REQUEST TO WORKSTREAM B: console on PE2/PE3, or on PB6/PB7 with
# CONS_INDEX=4.  Any other pins cost a patch to mainline board.c.
CONFIG_CONS_INDEX=1

# --- Handover state: secure SVC, not non-secure HYP --------------------------
# CORRECTED 2026-09-18.  BRINGUP.md section 4.4 inferred that U-Boot hands a
# payload over in secure PL1/SVC.  That is true of `go`.  It is NOT true of
# `bootm`, which is the handover this project chose, because
# arch/arm/cpu/armv7/Kconfig defaults ARMV7_NONSEC=y (line 15) and
# ARMV7_VIRT=y (line 76), and armv7_boot_nonsec() (arch/arm/lib/bootm.c:213)
# returns TRUE unless ARMV7_BOOT_SEC_DEFAULT is set or the environment says
# `bootm_boot_mode=sec`.  boot_jump_linux() then goes through
# _do_nonsec_entry -> smc #0 -> _secure_monitor
# (arch/arm/cpu/armv7/nonsec_virt.S:76-105), which sets SCR.NS and, on a
# virtualisation-capable core -- which the Cortex-A7 is -- selects HYP_MODE
# for the target.  The payload would be entered in NON-SECURE HYP.
#
# emu/src/start.S assumes SVC ("PL1, SVC mode, (inferred) secure", its header)
# and switches mode with `msr cpsr_c`, which cannot leave HYP.  It would stay
# in HYP, write VBAR instead of HVBAR, and set up five mode stacks that are
# all the HYP stack.  Silent.
#
# Setting this makes `bootm` hand over in SECURE SVC with the MMU and caches
# off, which is the state start.S documents.  Cost: U-Boot's PSCI secure
# monitor is then not left installed, so starting CPU1 is the payload's job
# again (BRINGUP.md section 4.3).  Single-core is the plan for now.
# The runtime equivalent, if you want to try the other way without rebuilding,
# is `setenv bootm_boot_mode sec`.
CONFIG_ARMV7_BOOT_SEC_DEFAULT=y

# --- Misc -------------------------------------------------------------------
# CONFIG_SYS_MALLOC_CLEAR_ON_INIT is not set
